{
  "name": "@synvox/sql",
  "version": "5.0.0-alpha.1",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "start": "vitest",
    "build": "npx tsup",
    "test": "vitest run",
    "prepublish": "npm run test && npm run build",
    "publish": "np"
  },
  "typings": "dist/index.d.ts",
  "repository": "https://github.com/Synvox/sql",
  "files": [
    "dist"
  ],
  "jest": {
    "testPathIgnorePatterns": [
      "test/types"
    ]
  },
  "devDependencies": {
    "@types/debug": "4.1.12",
    "@types/pg": "8.15.4",
    "@types/pluralize": "0.0.33",
    "np": "10.2.0",
    "prettier": "3.6.2",
    "tslib": "2.8.1",
    "tsup": "8.5.0",
    "typescript": "5.8.3",
    "vitest": "3.2.4",
    "pg": "*"
  },
  "dependencies": {
    "debug": "*",
    "pluralize": "8.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./migrations": {
      "import": "./dist/migrations.js",
      "types": "./dist/migrations.d.ts"
    }
  }
